{
	"name": "convertigo-studio-web",
	"version": "8.4.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node post-build.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --ignore \"src/lib/studio/**/*\" --watch",
		"test": "npm run test:integration && npm run test:unit",
		"lint": "prettier --plugin prettier-plugin-svelte --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest src",
		"check:palette": "node scripts/check-skeleton-pairs.mjs",
		"update:bezels": "node scripts/update-bezels.mjs",
		"generate:thumbnails": "node scripts/generate-thumbnails.mjs",
		"deps:update": "npx npm-check-updates && npx npm-check-updates --no-peer --reject '/^(?!(svelte|tailwindcss)$).*/' && npm install",
		"deps:minor-update": "npx npm-check-updates --target minor && npx npm-check-updates --target minor --no-peer --reject '/^(?!(svelte|tailwindcss)$).*/' && npm install",
		"check:admin": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.admin.json",
		"lint:admin": "eslint \"src/lib/admin/**/*.{js,svelte,ts}\" \"src/lib/common/**/*.{js,svelte,ts}\" \"src/lib/dashboard/**/*.{js,svelte,ts}\" \"src/lib/utils/**/*.{js,svelte,ts}\" \"src/routes/(app)/admin/**/*.{js,svelte,ts}\" \"src/routes/(app)/dashboard/**/*.{js,svelte,ts}\" \"src/routes/(root)/login/**/*.{js,svelte,ts}\" \"src/routes/+layout.svelte\" \"src/routes/(app)/+layout.svelte\" --ignore-pattern \"src/routes/(app)/admin/certificates/**\" --ignore-pattern \"src/routes/(app)/admin/projects/**\" --ignore-pattern \"src/routes/(app)/admin/roles/**\" --ignore-pattern \"src/routes/(app)/admin/symbols/**\""
	},
	"overrides": {
		"svelte-tiny-virtual-list": {
			"@types/svelte": "^5.0.0",
			"svelte": "^5.57.2"
		}
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/svelte": "^5.2.2",
		"@playwright/test": "^1.64.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "0.5.11",
		"@types/node": "^26.6.4",
		"@typescript-eslint/parser": "^8.71.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.3.4",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@internationalized/date": "^3.12.4",
		"@tailwindcss/vite": "^4.3.3",
		"@xyflow/svelte": "^1.7.0",
		"@zag-js/tree-view": "^1.45.0",
		"apexcharts": "^5.16.0",
		"bits-ui": "^2.19.5",
		"dockview": "^8.4.1",
		"fast-xml-parser": "^5.11.2",
		"fs-extra": "^11.4.1",
		"html-entities": "^2.6.0",
		"marked": "^18.1.0",
		"monaco-editor": "^0.57.0",
		"svelte-persisted-state": "^1.4.1",
		"svelte-tiny-virtual-list": "^3.0.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
